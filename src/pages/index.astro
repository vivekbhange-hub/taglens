---
import Base from '../layouts/Base.astro';
import Checker from '../components/Checker.astro';
import Directory from '../components/Directory.astro';
import Faq from '../components/Faq.astro';

const title = 'TagLens: why does my photo say “AI info”? Free AI label checker';
const description = 'See exactly why Instagram, TikTok or LinkedIn labels your photo as AI. TagLens reads Content Credentials (C2PA), IPTC AI fields and EXIF in your browser, and removes private data like GPS from your own photos. Free, open source, no uploads.';

const faq: [string, string][] = [
  ['Why does Instagram say “AI info” on my photo?', 'Usually because the file itself declares AI. Tools like Photoshop Generative Fill, Adobe Firefly, ChatGPT, Google Magic Editor and Galaxy AI write a standard field (C2PA Content Credentials or the IPTC DigitalSourceType) into the image. Meta reads it and adds the label. TagLens shows you which field it is and which tool wrote it.'],
  ['Are my photos uploaded anywhere?', 'No. TagLens runs entirely in your browser. The file is read on your device and nothing is sent to a server. You can turn off your internet after the page loads and it still works.'],
  ['Can TagLens remove the AI label?', 'No, and that is deliberate. AI labels exist so people can tell real from generated. TagLens explains labels and keeps AI disclosure by default when it removes private data. It also cannot see or remove invisible watermarks like Google SynthID.'],
  ['What does the cleaner remove?', 'Location (GPS), camera and lens serial numbers, device details, dates, editing history, comments and AI prompt text saved by Stable Diffusion or ComfyUI. It copies the image data byte for byte, so there is no quality loss, and it keeps the colour profile and orientation.'],
  ['Which files work?', 'JPEG, PNG, WebP, HEIC and AVIF images, plus MP4 and MOV video for Content Credentials. Cleaning works for JPEG, PNG and WebP.'],
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication', name: 'TagLens', url: 'https://taglens.vivekbhange.tech/',
    applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description,
    author: { '@type': 'Person', name: 'Vivek Bhange', url: 'https://vivekbhange.tech' },
    license: 'https://opensource.org/licenses/MIT', codeRepository: 'https://github.com/vivekbhange-hub/taglens',
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Checker>
    <h1>Read the hidden tag on any photo.</h1>
    <p class="lede">Every image carries notes about itself: which app made it, whether AI touched it, where it was taken. Instagram and TikTok read those notes to decide on an “AI info” label. Now you can read them too.</p>
  </Checker>

  <Directory />

  <section class="wrap blind below">
    <h2>What no file reader can see</h2>
    <p>Invisible watermarks such as Google SynthID or Meta’s Video Seal live inside the pixels, and only their owners can read them. Platforms also run their own detection. So a file with nothing to report here can still be labelled, and TagLens will tell you that rather than pretend otherwise. <a href="/tools/ai-watermark-check/">More on AI watermarks</a>.</p>
  </section>

  <Faq items={faq}>
    <p class="more">Longer answers in the guides: <a href="/guides/ai-tag-remover/">what an AI tag remover can and can’t do</a>, <a href="/guides/why-instagram-says-ai-info/">why Instagram says “AI info”</a>, <a href="/guides/photoshop-generative-fill-ai-label/">Photoshop Generative Fill and the label</a>, and <a href="/guides/what-is-c2pa-content-credentials/">what Content Credentials are</a>.</p>
  </Faq>
</Base>

<style>
  .blind { margin-top: 96px; }
  .blind h2 { padding-top: 16px; border-top: 2px solid var(--ink); }
  .blind p { max-width: 72ch; color: var(--ink-2); font-size: 1.05rem; }
  .more { margin-top: 24px; color: var(--ink-2); }
</style>
