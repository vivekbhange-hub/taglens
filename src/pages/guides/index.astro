---
import Base from '../../layouts/Base.astro';
const guides = [
  ['/guides/why-instagram-says-ai-info/', 'Why does Instagram say “AI info” on my photo?', 'What triggers the label, why real photos get it, and what to do.'],
  ['/guides/photoshop-generative-fill-ai-label/', 'Photoshop Generative Fill and the “AI info” label', 'Which Adobe features declare AI and how to check your export.'],
  ['/guides/what-is-c2pa-content-credentials/', 'What are Content Credentials (C2PA)?', 'The signed history inside a file, compared with IPTC fields and watermarks.'],
];
---
<Base title="Guides: AI labels, Content Credentials and photo metadata | TagLens" description="Plain-English guides to AI labels on Instagram, TikTok and LinkedIn, Content Credentials (C2PA), IPTC AI fields and photo privacy.">
  <section class="wrap narrow" style="padding-top:56px">
    <h1 style="font-size:clamp(2.1rem,5vw,3.1rem)">AI labels, explained</h1>
    <ul class="guide-list">
      {guides.map(([href, t, d]) => (
        <li><a href={href}>{t}</a><span>{d}</span></li>
      ))}
    </ul>
  </section>
</Base>
