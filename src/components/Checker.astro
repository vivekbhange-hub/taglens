---
// The drop-a-file hero plus the report area. Every page that checks files uses this,
// with a preset that decides which cleaner boxes start ticked and which part shows first.
interface Props { preset?: object; }
const { preset = {} } = Astro.props;

// Faint, real-looking metadata typed behind the hero: the "hidden notes" the page reveals.
const ghost = [
  'Make Canon', 'Model EOS R6', 'GPSLatitude 18°31\'12.3" N', 'GPSLongitude 73°51\'20.0" E', 'DateTimeOriginal 2026:10:12 18:42:07',
  'Software Adobe Photoshop 26.1', 'DigitalSourceType trainedAlgorithmicMedia', 'c2pa.actions.v2 c2pa.created', 'BodySerialNumber 0123456789',
  'parameters: portrait of an astronaut cat, Steps: 30, Seed: 1234567890', 'CreatorTool Adobe Firefly', 'LensSerialNumber 9876543',
  'compositeWithTrainedAlgorithmicMedia', 'claim_generator ChatGPT', 'OwnerName', 'xmpMM:History saved',
].join('   ');
---
<section class="stage" id="checker" data-preset={JSON.stringify(preset)}>
  <div class="ghost" aria-hidden="true">{ghost} {ghost} {ghost}</div>
  <div class="wrap stage-grid">
    <div class="stage-copy">
      <slot />
      <p class="promise">Read in this browser tab. Never uploaded.</p>
    </div>
    <label class="droptag" id="drop" for="file">
      <input id="file" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,image/avif,video/mp4,video/quicktime,.heic,.heif,.avif" />
      <svg class="cord" viewBox="0 0 200 160" aria-hidden="true"><path d="M110 92 C 60 70, 30 140, -40 120" /></svg>
      <span class="droptag-body">
        <span class="dt-line big">Drop a photo or video on this tag</span>
        <span class="dt-line">or <u>choose a file</u>, or paste with Ctrl+V</span>
        <span class="dt-line small">JPEG  PNG  WebP  HEIC  AVIF  MP4  MOV</span>
        <span class="dt-stamp"><span class="idle">Not read yet</span><span class="armed">Let go to read</span></span>
      </span>
    </label>
  </div>
  <div class="wrap dropbox-row">
    <label class="dropbox" for="file">
      <svg class="db-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m0 0L7.5 8.5M12 4l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 14v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span class="db-text">
        <strong>Drag and drop a file here</strong>
        <span>JPEG, PNG, WebP, HEIC, AVIF, MP4 or MOV, up to 300 MB</span>
      </span>
      <span class="btn db-btn">Browse files</span>
    </label>
  </div>
</section>

<div class="wrap">
  <p class="status" id="status" role="status" aria-live="polite"></p>
  <div id="results" hidden></div>
</div>
<div class="drop-veil" aria-hidden="true"><span>Drop to check this file</span></div>

<style is:global>
  /* ---------- stage ---------- */
  .stage { position: relative; overflow: hidden; padding: 56px 0 40px; border-bottom: 1px solid var(--rule); }
  .stage.has-result { display: none; }
  .ghost {
    position: absolute; inset: -20px -40px; z-index: 0; pointer-events: none; user-select: none;
    font: 400 15px/2.1 var(--type); color: #e6e9ee; word-spacing: 6px; overflow: hidden; transform: rotate(-4deg);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 44%, #000 62%, #000 88%, transparent 100%);
  }
  .stage-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 1fr; gap: 40px; align-items: center; }
  @media (max-width: 880px) {
    .stage-grid { grid-template-columns: 1fr; gap: 36px; } .stage { padding-top: 32px; }
    .ghost { mask-image: linear-gradient(180deg, transparent 0%, transparent 52%, #000 70%, #000 100%); }
  }
  .stage-copy h1 { max-width: 12ch; }
  .stage-copy .lede { font-size: 1.15rem; color: var(--ink-2); max-width: 48ch; }
  .promise { display: inline-flex; gap: 10px; align-items: center; font-weight: 600; color: var(--stamp-green); margin: 4px 0 0; background: var(--paper); padding: 2px 0; }
  .promise::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 20%, transparent); }

  .droptag { position: relative; display: block; cursor: pointer; justify-self: center; width: min(470px, 100%); view-transition-name: tag; }
  .droptag input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .cord { position: absolute; left: -6%; top: 6%; width: 46%; height: auto; overflow: visible; z-index: 2; pointer-events: none; }
  .cord path { fill: none; stroke: #8a6a3a; stroke-width: 2.2; stroke-linecap: round; }
  .droptag-body {
    position: relative; display: flex; flex-direction: column; gap: 6px; min-height: 290px; padding: 40px 30px 30px 26%;
    background: var(--kraft); color: var(--kraft-ink); font-family: var(--type);
    clip-path: polygon(17% 0, 100% 0, 100% 100%, 17% 100%, 0 50%);
    filter: drop-shadow(0 18px 22px rgba(20, 24, 31, .18));
    rotate: -3deg; transition: rotate .35s cubic-bezier(.3, 1.5, .5, 1), translate .35s cubic-bezier(.3, 1.5, .5, 1);
  }
  .droptag-body::before { /* reinforced eyelet */
    content: ''; position: absolute; left: 11%; top: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%;
    background: var(--paper); box-shadow: 0 0 0 7px var(--kraft-dark), inset 0 1px 2px rgba(0, 0, 0, .25);
  }
  .droptag:hover .droptag-body, .droptag:focus-within .droptag-body { rotate: -1deg; translate: 0 -4px; }
  .droptag:focus-within { outline: none; }
  .droptag:focus-within .droptag-body { outline: 3px solid var(--stamp-blue); outline-offset: 4px; }
  body.dragging .droptag-body { rotate: 1deg; translate: 0 -8px; }
  .dt-line { display: block; }
  .dt-line.big { font: 700 1.55rem/1.15 var(--type); letter-spacing: -0.01em; margin-bottom: 6px; }
  .dt-line.small { font-size: 0.82rem; opacity: .7; letter-spacing: .04em; }
  .dt-stamp {
    align-self: flex-start; margin-top: auto; padding: 6px 12px 4px; border: 3px dashed color-mix(in srgb, var(--kraft-ink) 45%, transparent); border-radius: 5px;
    font: 700 1rem/1 var(--type); letter-spacing: .08em; text-transform: uppercase; color: color-mix(in srgb, var(--kraft-ink) 55%, transparent); rotate: -4deg;
  }
  .dt-stamp .armed { display: none; }
  body.dragging .dt-stamp { border-style: solid; color: var(--stamp-blue); border-color: var(--stamp-blue); }
  body.dragging .dt-stamp .idle { display: none; }
  body.dragging .dt-stamp .armed { display: inline; }

  .drop-veil { position: fixed; inset: 0; z-index: 30; display: none; place-items: center; background: rgba(255, 255, 255, .85); backdrop-filter: blur(3px); }
  .drop-veil span { font: 700 1.6rem var(--type); padding: 18px 26px; border: 3px solid var(--stamp-blue); color: var(--stamp-blue); border-radius: 8px; rotate: -3deg; }
  body.dragging.result-mode .drop-veil { display: grid; }

  /* ---------- standard drop box ---------- */
  .dropbox-row { position: relative; z-index: 1; margin-top: 40px; }
  .dropbox {
    display: flex; align-items: center; gap: 18px; padding: 22px 26px; cursor: pointer;
    border: 2px dashed var(--rule-2); border-radius: 14px; background: var(--paper-2);
    transition: border-color .15s, background-color .15s;
  }
  .dropbox:hover { border-color: var(--ink-2); background: var(--paper-2); }
  body.dragging .dropbox { border-color: var(--stamp-blue); border-style: solid; background: color-mix(in srgb, var(--stamp-blue) 7%, var(--paper)); }
  .stage:has(#file:focus-visible) .dropbox { outline: 3px solid var(--stamp-blue); outline-offset: 3px; }
  .db-icon { flex: none; width: 46px; height: 46px; padding: 11px; border-radius: 50%; background: var(--paper); color: var(--stamp-blue); border: 1px solid var(--rule); }
  .db-text { display: grid; gap: 2px; margin-right: auto; }
  .db-text strong { font-size: 1.08rem; }
  .db-text span { color: var(--muted); font-size: 0.93rem; }
  .db-btn { flex: none; pointer-events: none; }
  @media (max-width: 560px) {
    .dropbox { flex-direction: column; text-align: center; padding: 22px 18px; }
    .db-text { margin-right: 0; }
  }

  .status { min-height: 1.6em; margin: 14px 0 0; color: var(--muted); }
  .status.error { color: var(--stamp-red); font-weight: 600; }

  /* ---------- exhibit: print + tag ---------- */
  .exhibit { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; align-items: start; padding-top: 18px; }
  @media (max-width: 860px) { .exhibit { grid-template-columns: 1fr; gap: 24px; } }
  .specimen { position: relative; min-height: 380px; }
  .print { width: 56%; background: #fff; padding: 10px 10px 36px; border: 1px solid var(--rule); box-shadow: 0 14px 30px -18px rgba(20, 24, 31, .45); rotate: -1.5deg; }
  .print img, .print video { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--paper-2); }
  .print .noprev { display: grid; place-items: center; aspect-ratio: 4 / 5; background: var(--paper-2); color: var(--muted); font-size: 0.9rem; text-align: center; padding: 10px; }
  .tag {
    position: absolute; right: -2%; top: 40px; width: 70%; min-width: 260px; view-transition-name: tag;
    padding: 22px 22px 22px 19%; background: var(--kraft); color: var(--kraft-ink);
    font-family: var(--type); font-size: 0.86rem; line-height: 1.5;
    clip-path: polygon(15% 0, 100% 0, 100% 100%, 15% 100%, 0 50%);
    filter: drop-shadow(0 12px 14px rgba(20, 24, 31, .22));
    rotate: 2.5deg;
  }
  .tag::before { content: ''; position: absolute; left: 9%; top: 50%; width: 15px; height: 15px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--paper); box-shadow: 0 0 0 5px var(--kraft-dark); }
  .tag dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 2px 10px; }
  .tag dt { opacity: .7; }
  .tag dd { margin: 0; word-break: break-word; font-weight: 700; }
  .stamp {
    display: inline-block; margin-top: 14px; padding: 6px 11px 4px; border: 3px solid currentColor; border-radius: 5px;
    font: 700 1.05rem/1 var(--type); letter-spacing: .07em; text-transform: uppercase; rotate: -5deg; mix-blend-mode: multiply;
    animation: thunk .5s .7s cubic-bezier(.2, 1.6, .4, 1) both;
  }
  @keyframes thunk { 0% { opacity: 0; scale: 1.6; } 100% { opacity: .92; scale: 1; } }
  .stamp.ai { color: var(--stamp-red); }
  .stamp.warn { color: var(--stamp-amber); }
  .stamp.info { color: var(--stamp-blue); }
  .stamp.ok { color: var(--stamp-green); }
  @media (max-width: 520px) {
    .specimen { min-height: 0; }
    .print { width: 80%; }
    .tag { position: relative; width: 100%; top: 0; margin-top: -44px; }
  }
  ::view-transition-group(tag) { animation-duration: .55s; animation-timing-function: cubic-bezier(.3, 1.2, .4, 1); }

  /* Focus lands here after a result so screen readers announce it; it isn't a control, so no ring. */
  .reading h2:focus, .reading h2:focus-visible { outline: none; }
  .reading h2 { font-size: clamp(1.9rem, 3.8vw, 2.8rem); line-height: 1.04; letter-spacing: -0.03em; }
  .reading .sum { font-size: 1.1rem; color: var(--ink-2); max-width: 48ch; }
  .reading .acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .acts .ico { width: 18px; height: 18px; flex: none; }
  .quick-note { margin-top: 14px; color: var(--muted); font-size: 0.92rem; max-width: 52ch; }
  .quick-note p { margin: 0 0 10px; color: var(--ink-2); }
  .quick-note a { color: var(--ink-2); margin-left: 12px; }
  .quick-note > a:first-of-type { margin-left: 0; }
  .note-pill { display: inline-block; margin-bottom: 12px; font-weight: 650; color: var(--stamp-blue); }

  /* ---------- report ---------- */
  .part { margin-top: 56px; }
  .part > h2 { padding-top: 16px; border-top: 2px solid var(--ink); display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .part > h2 small { font-size: 0.92rem; font-weight: 450; letter-spacing: 0; color: var(--muted); }
  .part.focus > h2 { border-top-color: var(--stamp-blue); }
  .part .aside { color: var(--muted); font-size: 0.9rem; margin-top: 12px; max-width: 80ch; }
  .empty { color: var(--ink-2); padding: 6px 0; }

  .ledger { width: 100%; border-collapse: collapse; }
  .ledger td { padding: 14px 16px 14px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .ledger td:first-child { font-weight: 700; width: 22%; }
  .ledger td:nth-child(2) { width: 30%; font-weight: 650; }
  .ledger td:last-child { color: var(--muted); font-size: 0.92rem; padding-right: 0; }
  .ledger .mk { display: inline-block; width: 10px; height: 10px; margin-right: 8px; border-radius: 2px; background: currentColor; }
  .lv-label { color: var(--stamp-red); }
  .lv-menu, .lv-disclose { color: var(--stamp-amber); }
  .lv-badge { color: var(--stamp-blue); }
  .lv-none { color: var(--stamp-green); }
  @media (max-width: 680px) {
    .ledger tr { display: grid; grid-template-columns: 1fr; padding: 12px 0; border-bottom: 1px solid var(--rule); }
    .ledger td { border: 0; padding: 2px 0; width: auto !important; }
  }

  .findings { list-style: none; margin: 0; padding: 0; }
  .findings li { display: grid; grid-template-columns: 92px 1fr; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .findings .kind { font-weight: 700; font-size: 0.9rem; }
  .findings .kind.declared { color: var(--stamp-red); }
  .findings .kind.hint { color: var(--muted); }
  .findings strong { display: block; }
  .findings .d { color: var(--ink-2); font-size: 0.95rem; word-break: break-word; }
  .findings .src { display: block; color: var(--muted); font-size: 0.85rem; margin-top: 2px; }

  .cred { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px; }
  @media (max-width: 760px) { .cred { grid-template-columns: 1fr; gap: 18px; } }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 20px; margin: 0; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-weight: 600; word-break: break-word; }
  .facts .bad { color: var(--stamp-red); }
  .facts .good { color: var(--stamp-green); }
  .steps { list-style: none; margin: 0; padding: 0 0 0 22px; border-left: 2px solid var(--rule); }
  .steps li { position: relative; padding: 0 0 14px; }
  .steps li::before { content: ''; position: absolute; left: -29px; top: 7px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); border: 2px solid var(--k-c2pa); }
  .steps li.ing::before { border-color: var(--k-image); }
  .steps small { color: var(--muted); }

  .strip { display: flex; height: 44px; gap: 3px; padding: 5px; border: 1px solid var(--rule-2); border-radius: 8px; background: var(--paper); }
  .strip span { min-width: 5px; background: var(--c); border-radius: 3px; }
  .key { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 12px; font-size: 0.9rem; color: var(--ink-2); }
  .key i { display: inline-block; width: 11px; height: 11px; background: var(--c); margin-right: 8px; vertical-align: -1px; border-radius: 3px; }

  .priv { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .priv td { padding: 11px 14px 11px 0; border-bottom: 1px solid var(--rule); vertical-align: top; word-break: break-word; }
  .priv td:first-child { width: 28%; color: var(--ink-2); }
  .priv td:last-child { width: 70px; text-align: right; padding-right: 0; font-weight: 700; font-size: 0.85rem; }
  .priv a { white-space: nowrap; }
  .risk-high { color: var(--stamp-red); }
  .risk-medium { color: var(--stamp-amber); }
  .risk-low { color: var(--muted); }
  .typed { font-family: var(--type); font-size: 0.85rem; white-space: pre-wrap; background: var(--paper-2); border-left: 3px solid var(--k-ai); padding: 10px 12px; max-height: 170px; overflow: auto; margin-top: 6px; }
  .priv summary { cursor: pointer; }

  .cleaner .opts { margin: 0 0 18px; }
  .opt { display: grid; grid-template-columns: 22px 1fr; gap: 12px; padding: 13px 0; border-bottom: 1px solid var(--rule); cursor: pointer; }
  .opt input { width: 18px; height: 18px; margin: 3px 0 0; accent-color: var(--ink); }
  .opt small { display: block; color: var(--muted); font-size: 0.9rem; }
  .opt.off { opacity: .45; cursor: default; }
  .opt.sub { padding-left: 34px; }
  .opt.keep { border-bottom: 2px solid var(--stamp-green); }
  .opt.keep input { accent-color: var(--stamp-green); }
  .caution { border-left: 4px solid var(--stamp-amber); padding: 4px 0 4px 14px; margin: 0 0 16px; color: var(--ink-2); font-size: 0.95rem; }
  .done { margin-top: 16px; }
</style>

<script>
  import { mount } from '../scripts/app.js';
  mount();
</script>
