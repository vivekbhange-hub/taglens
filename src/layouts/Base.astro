---
import '../styles/global.css';
import { TOOLS, GROUPS } from '../data/tools.js';
import { PLATFORMS, AI_TOOLS } from '../data/pages.js';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
}
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const REPO = 'https://github.com/vivekbhange-hub/taglens';
const chev = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const speculation = JSON.stringify({ prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="author" content="Vivek Bhange" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TagLens" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script type="speculationrules" set:html={speculation} />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/" aria-label="TagLens home">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 16 10 6h18a1.5 1.5 0 0 1 1.5 1.5v17A1.5 1.5 0 0 1 28 26H10Z" fill="#d9b77f" stroke="#14181f" stroke-width="2" stroke-linejoin="round"/><circle cx="10.5" cy="16" r="2.3" fill="#fff" stroke="#14181f" stroke-width="2"/><path d="M16 13h9M16 19h6" stroke="#14181f" stroke-width="2.2" stroke-linecap="round"/></svg>
          TagLens
        </a>
        <nav class="nav" aria-label="Main">
          <button popovertarget="menu-tools" set:html={`Tools ${chev}`} />
          <button class="wide" popovertarget="menu-platforms" set:html={`Platforms ${chev}`} />
          <button class="wide" popovertarget="menu-ai" set:html={`AI apps ${chev}`} />
          <a class="wide" href="/guides/">Guides</a>
          <a href={REPO} rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <div class="menu" id="menu-tools" popover>
      <div class="menu-cols">
        {GROUPS.map((g) => (
          <div>
            <h3>{g.name}</h3>
            <ul>
              {TOOLS.filter((t) => t.group === g.id).map((t) => (
                <li><a href={`/tools/${t.slug}/`}><i style={`--c: var(--k-${t.kind})`}></i><b>{t.name}</b><span>{t.short}</span></a></li>
              ))}
              {g.id === 'learn' && <li><a href="/guides/"><i style="--c: var(--k-other)"></i><b>All guides</b><span>Plain-English explainers on AI labels.</span></a></li>}
            </ul>
          </div>
        ))}
        <div class="narrow-only">
          <h3>Platforms</h3>
          <ul>{PLATFORMS.map((p) => <li><a href={`/platforms/${p.slug}/`}><i style="--c: var(--stamp-blue)"></i><b>{p.name}</b><span>How it labels AI</span></a></li>)}</ul>
        </div>
        <div class="narrow-only">
          <h3>AI apps</h3>
          <ul>{AI_TOOLS.map((p) => <li><a href={`/ai/${p.slug}/`}><i style="--c: var(--k-ai)"></i><b>{p.name}</b><span>What it writes into files</span></a></li>)}</ul>
        </div>
      </div>
    </div>
    <div class="menu" id="menu-platforms" popover>
      <div class="menu-cols">
        <div>
          <h3>How each platform labels AI</h3>
          <ul>{PLATFORMS.map((p) => <li><a href={`/platforms/${p.slug}/`}><i style="--c: var(--stamp-blue)"></i><b>{p.name}{p.also ? `, ${p.also}` : ''}</b><span>{p.h1}</span></a></li>)}</ul>
        </div>
      </div>
    </div>
    <div class="menu" id="menu-ai" popover>
      <div class="menu-cols">
        <div>
          <h3>What AI apps write into your files</h3>
          <ul>{AI_TOOLS.map((p) => <li><a href={`/ai/${p.slug}/`}><i style="--c: var(--k-ai)"></i><b>{p.name}</b><span>{p.h1}</span></a></li>)}</ul>
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>
    <script>
      if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
        const menus = [...document.querySelectorAll('.menu')];
        const closeAll = (except) => menus.forEach((m) => m !== except && m.classList.remove('is-open'));
        document.querySelectorAll('[popovertarget]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const m = document.getElementById(btn.getAttribute('popovertarget'));
            closeAll(m);
            m?.classList.toggle('is-open');
          });
        });
        document.addEventListener('click', (e) => { if (!e.target.closest('.menu')) closeAll(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
      }
    </script>

    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div>
          <p><strong>TagLens</strong> reads the hidden data in photos and videos, right in your browser. Nothing is uploaded.</p>
          <p>Made by <a href="https://vivekbhange.tech" rel="author">Vivek Bhange</a>. Open source under the MIT licence.</p>
        </div>
        <div><h3>Remove</h3><ul>{TOOLS.filter((t) => t.group === 'clean').map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}</ul></div>
        <div><h3>Check</h3><ul>{TOOLS.filter((t) => t.group !== 'clean').map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}</ul></div>
        <div><h3>More</h3><ul>
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href={REPO} rel="noopener">Source on GitHub</a></li>
          <li><a href="https://vivekbhange.tech" rel="author">vivekbhange.tech</a></li>
        </ul></div>
      </div>
    </footer>
  </body>
</html>
